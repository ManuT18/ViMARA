{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "ignorePatterns": ["public/unity_ar/Build/**", "public/unity_ar/zappar-cv.js", "unity_ar/Assets/WebGLTemplates/**", "dist/**", "unity_ar/Library/**", "unity_ar/Temp/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
