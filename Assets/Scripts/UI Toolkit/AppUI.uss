/* Contenedor general que ocupa toda la pantalla */
.screen-container {
    flex-grow: 1;
    background-color: rgba(28, 28, 30, 0.97);
    align-items: center;
    justify-content: center;
    padding: 20px;
}

/* Títulos principales */
.title-label {
    font-size: 150px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 100px;
    letter-spacing: 5px;
}

.subtitle-label {
    font-size: 50px;
    width: 99%;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    margin-bottom: 100px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.subtitle-label-2 {
    font-size: 60px;
    width: 99%;
    -unity-font-style: bold;
    color: rgba(200, 200, 200, 1);
    margin-bottom: 100px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.tap-to-start-label {
    font-size: 35px;
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
}

/* Estilo Base para los Botones */
.action-button {
    font-size: 40px;
    color: rgb(255, 255, 255);
    background-color: rgba(45, 122, 255, 0.29);
    border-radius: 15px;
    padding-top: 20px;
    padding-bottom: 20px;
    width: 70%;
    max-width: 75%;
    margin-top: 15px;
    margin-bottom: 15px;
    border-width: 0;
    transition-property: background-color, scale;
    transition-duration: 0.2s, 0.2s;
}

/* Efectos Hover/Active para botones */
.action-button:hover {
    background-color: rgb(75, 142, 255);
    scale: 1.02;
}

.action-button:active {
    background-color: rgb(25, 102, 225);
    scale: 0.98;
}

/* Botón secundario (Gris oscuro) */
.secondary-button {
    background-color: rgb(60, 60, 65);
}

.secondary-button:hover {
    background-color: rgb(80, 80, 85);
}

.secondary-button:active {
    background-color: rgb(40, 40, 45);
}

/* Botón flotante de Información (?) */
.info-button {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(60, 60, 65, 0.9);
    background-image: url('project://database/Assets/Sprites/help_icon.png');
    -unity-background-scale-mode: scale-to-fit;
    position: absolute;
    top: 50px;
    right: 50px;
    border-width: 0;
    transition-duration: 0.2s;
}

.info-button:hover {
    background-color: rgba(80, 80, 85, 1);
    scale: 1.05;
}

.info-button:active {
    scale: 0.95;
    background-color: rgba(40, 40, 45, 1);
}

/* Botón flotante de Salida (X) */
.exit-button {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(60, 60, 65, 0.9);
    background-image: url('project://database/Assets/Sprites/close_icon.png');
    -unity-background-scale-mode: scale-to-fit;
    position: absolute;
    top: 50px;
    left: 50px;
    border-width: 0;
    transition-duration: 0.2s;
}

.exit-button:hover {
    background-color: rgba(80, 80, 85, 1);
    scale: 1.05;
}

.exit-button:active {
    scale: 0.95;
    background-color: rgba(180, 50, 50, 1);
}

/* Botón flotante de Atrás (←) */
.back-button {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(60, 60, 65, 0.9);
    background-image: url('project://database/Assets/Sprites/arrow_back_icon.png');
    -unity-background-scale-mode: scale-to-fit;
    position: absolute;
    top: 50px;
    left: 50px;
    border-width: 0;
    transition-duration: 0.2s;
    font-size: 60px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.back-button:hover {
    background-color: rgba(80, 80, 85, 1);
    scale: 1.05;
}

.back-button:active {
    scale: 0.95;
    background-color: rgba(180, 50, 50, 1);
}

/* Estilos de la Ventana Emergente POPUP */
.popup-container {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

.popup-content {
    background-color: rgb(35, 35, 40);
    border-radius: 40px;
    padding: 60px;
    width: 85%;
    max-width: 800px;
    align-items: center;
}

.popup-text {
    font-size: 35px;
    color: rgb(220, 220, 220);
    white-space: normal;
    margin-bottom: 50px;
    -unity-text-align: middle-left;
    width: 100%;
    line-height: 1.5;
}

/* Contenedor interno para los Paneles */
.panel {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

/* Estilo para el PreviewBox (Placeholder) */
.preview-box {
    width: 100%;
    height: 100%;
    background-color: rgba(10, 10, 15, 0.95);
    align-items: center;
    justify-content: center;
}

