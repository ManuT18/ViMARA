/* =========================================================================
   ViMARA - ARCHIVO DE ESTILOS PRINCIPAL (UI Toolkit)
   =========================================================================
   Aquí se definen los tamaños, colores y comportamiento de toda la interfaz.
   Está organizado por categorías para que sea fácil de mantener y escalar.
========================================================================= */


/* =========================================================================
   1. CONTENEDORES PRINCIPALES Y ESTRUCTURA
   Define cómo se distribuyen los elementos en la pantalla.
========================================================================= */

/* Contenedor general que ocupa absolutamente toda la pantalla */
.screen-container {
    flex-grow: 1;
    background-color: rgba(28, 28, 30, 0.97); 
    align-items: center;
    justify-content: center;
    padding: 20px;
}

/* Pantallas individuales (Menú, Importar, etc.) */
.panel {
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}


/* =========================================================================
   2. TIPOGRAFÍA Y TEXTOS
   Estilos de todas las fuentes y tamaños de letras legibles en el celular.
========================================================================= */

/* Título principal */
.title-label {
    font-size: 150px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 100px;
    letter-spacing: 5px;
}

/* Subtítulo descriptivo en el menú principal */
.subtitle-label {
    font-size: 50px;
    width: 99%;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    margin-bottom: 100px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Subtítulos para los encabezados de las pantallas de navegación */
.subtitle-label-2 {
    font-size: 60px;
    width: 99%;
    -unity-font-style: bold;
    color: rgba(200, 200, 200, 1);
    margin-bottom: 100px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Texto en cursiva para llamadas a la acción */
.tap-to-start-label {
    font-size: 35px;
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
}


/* =========================================================================
   3. BOTONES DE ACCIÓN PRINCIPALES
========================================================================= */

/* Estructura común para "Plano Libre", "Buscar Modelo", etc. */
.action-button {
    font-size: 40px;
    color: rgb(255, 255, 255);
    background-color: rgba(45, 122, 255, 0.29); 
    border-radius: 15px;
    padding-top: 20px;
    padding-bottom: 20px;
    width: 70%;
    max-width: 75%;
    margin-top: 15px;
    margin-bottom: 15px;
    border-width: 0;
    transition-property: background-color, scale;
    transition-duration: 0.2s, 0.2s; 
}

.action-button:hover {
    background-color: rgb(75, 142, 255);
    scale: 1.02;
}

.action-button:active {
    background-color: rgb(25, 102, 225);
    scale: 0.98;
}

/* Variación secundaria (Gris Oscuro) usada para botones deshabilitados o secundarios */
.secondary-button {
    background-color: rgb(60, 60, 65);
}

.secondary-button:hover { background-color: rgb(80, 80, 85); }
.secondary-button:active { background-color: rgb(40, 40, 45); }


/* =========================================================================
   4. BOTONES FLOTANTES CIRCULARES 
========================================================================= */

.info-button, .exit-button, .back-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;        
    background-color: rgba(60, 60, 65, 0.9);
    background-size: 50% 50%;   
    background-position: center;
    background-repeat: no-repeat;
    position: absolute;         
    border-width: 0;
    transition-duration: 0.2s;
}

/* Animaciones combinadas */
.info-button:hover, .exit-button:hover, .back-button:hover {
    background-color: rgba(80, 80, 85, 1);
    scale: 1.05;
}

/* Posiciones e Íconos individuales */

/* Botón flotante de Información (?) */
.info-button {
    background-image: url('project://database/Assets/Sprites/help_icon.svg');
    background-size: 43% 43%;
    top: 40px;
    right: 40px;
}
.info-button:active { scale: 0.95; background-color: rgba(40, 40, 45, 1); }

/* Botón flotante de Salida (X) */
.exit-button {
    background-image: url('project://database/Assets/Sprites/close_icon.svg');
    top: 40px;
    left: 40px;
}
.exit-button:active { scale: 0.95; background-color: rgba(180, 50, 50, 1); }

/* Botón flotante de Atrás (<-) */
.back-button {
    background-image: url('project://database/Assets/Sprites/arrow_back_icon.svg');
    top: 40px;
    left: 40px;
}
.back-button:active { scale: 0.95; background-color: rgba(180, 50, 50, 1); }


/* =========================================================================
   5. COMPONENTES ESPECIALES
   Popups de ayuda visuales y cajas renderizadoras de modelos 3D.
========================================================================= */

/* Fondo oscurecido para la ventana de manual / instrucciones */
.popup-container {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

/* La tarjeta gris central del popup */
.popup-content {
    background-color: rgb(35, 35, 40);
    border-radius: 40px;
    padding: 60px;
    width: 85%;
    max-width: 800px;
    align-items: center;
}

.popup-text {
    font-size: 35px;
    color: rgb(220, 220, 220);
    white-space: normal;
    margin-bottom: 50px;
    -unity-text-align: middle-left;
    width: 100%;
    line-height: 1.5;
}

/* Estilo para el reproductor hueco donde renderizaremos el modelo 3D */
.preview-box {
    aspect-ratio: 1;
    width: 60%;
    /*height: 50%;*/
    max-width: 600px;
    max-height: 600px;
    border-radius: 40px;
    background-color: rgba(10, 10, 15, 0.95);
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
}
