<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <!-- Incluimos los estilos -->
    <ui:Style src="AppUI.uss" />

    <!-- Container Global que abarca toda la pantalla -->
    <ui:VisualElement class="screen-container">

        <!-- Botones Flotantes Globales Absolutos -->
        <ui:Button name="Btn_GlobalBack" class="back-button" style="display: none;" />
        <ui:Button name="Btn_SelectionInfo" class="info-button" style="display: none;" />
        <ui:Button name="Btn_ExitApp" class="exit-button" style="display: none;" />

        <!-- ========================================== -->
        <!-- PANTALLA 1: MAIN MENU                      -->
        <!-- ========================================== -->
        <ui:VisualElement name="MainMenu" class="panel" style="display: flex;">
            <ui:Label text="ViMARA" class="title-label" />
            <ui:Label text="Visualizador de Maquetas de Arquitectura en Realidad Aumentada" class="subtitle-label" style="margin-bottom: 80px;" />
            <ui:Label text="Presiona la pantalla para comenzar" class="tap-to-start-label" style="margin-top: 100px;" />
        </ui:VisualElement>


        <!-- ========================================== -->
        <!-- PANTALLA 2: MODE SELECTION                 -->
        <!-- ========================================== -->
        <ui:VisualElement name="ModeSelection" class="panel" style="display: none;">
            <ui:Label text="Selecciona el modo de visualización" class="subtitle-label-2" />
            
            <ui:Button name="Btn_SelectPlane" text="Plano Libre" class="action-button" />
            <ui:Button name="Btn_SelectMarker" text="Marcador Fijo" class="action-button" style="margin-top: 50px;" />
        </ui:VisualElement>


        <!-- ========================================== -->
        <!-- PANTALLA 3: MODEL IMPORT                   -->
        <!-- ========================================== -->
        <ui:VisualElement name="ModelImport" class="panel" style="display: none;">
            <ui:Label text="Importar Modelo" class="subtitle-label-2" />
            <ui:Label text="(Formatos soportados: .gltf, .glb)" style="color: rgb(150, 150, 150); font-size: 30px; margin-bottom: 50px;" />
            
            <!-- Búsqueda de Archivo -->
            <ui:Button name="Btn_OpenFileBrowser" text="Buscar Modelo" class="action-button" style="margin-bottom: 30px;" />
            <ui:Label name="Lbl_FileStatus" text="Ningún archivo seleccionado" style="color: rgb(200, 200, 200); font-size: 27px; margin-bottom: 50px; -unity-font-style: italic;" />

            <!-- Contenedor del Preview (Aparece al seleccionar) -->
            <ui:VisualElement name="PreviewBox" class="preview-box" style="display: none;" />

            <!-- Este botón inicia la escena AR real, lo enlazaremos luego -->
            <ui:Button name="Btn_StartAR" text="Visualizar en AR" class="action-button secondary-button" style="opacity: 0.5; margin-top: 50px;" />
        </ui:VisualElement>

        <!-- ========================================== -->
        <!-- POP-UP INFO MODOS                          -->
        <!-- ========================================== -->
        <ui:VisualElement name="InfoPopup" class="popup-container" style="display: none;">
            <ui:VisualElement class="popup-content">
                <ui:Label text="Información de Modos" class="subtitle-label" style="font-size: 45px; margin-bottom: 60px; color: rgb(150, 150, 150);" />
                <ui:Label text="Plano Libre: Detecta superficies planas reales (mesas, piso) para ubicar el modelo a tamaño real" class="popup-text" />
                <ui:Label text="Marcador Fijo: Detecta una imagen predefinida y ancla el modelo 3D sobre ella" class="popup-text" />
                <ui:Label text="Toca en cualquier lugar para salir" class="tap-to-start-label" style="font-size: 25px; margin-top: 30px;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
